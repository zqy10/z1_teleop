  <version>0.0.1</version>
  <description>自定义消息包，用于主从端双机械臂遥操作的数据同步。</description>

  <maintainer email="mason.zqy@gmail.com">ZQY</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

